#!/usr/bin/env bash
# netwatch — live inbound + outbound traffic monitor using tshark
# Usage: netwatch [interface] [refresh_seconds]

IFACE="${1:-$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')}"
REFRESH="${2:-3}"

if ! command -v tshark &>/dev/null; then
    echo "tshark not found. Add to home.nix: programs.wireshark.enable = true" >&2; exit 1
fi
if [[ -z "$IFACE" ]]; then
    echo "Could not detect interface. Available:" >&2
    tshark -D 2>/dev/null | awk '{print "  " $0}' >&2; exit 1
fi
if [[ $EUID -ne 0 ]] && ! id -nG | grep -qw wireshark; then
    echo "Need root or wireshark group: add \"wireshark\" to users.users.$USER.extraGroups in configuration.nix" >&2; exit 1
fi

# Local IPv4 + IPv6 addresses on this interface — used to tell OUT (we're the
# source) from IN (we're the destination). VPN/tunnel interfaces are commonly
# IPv6-only or dual-stack, so both families need to be checked.
LOCAL_IPS=$( { ip -4 addr show dev "$IFACE" 2>/dev/null | awk '/inet /{print $2}'
               ip -6 addr show dev "$IFACE" 2>/dev/null | awk '/inet6/{print $2}'
             } | cut -d/ -f1)
if [[ -z "$LOCAL_IPS" ]]; then
    echo "Could not determine local IP for $IFACE" >&2; exit 1
fi
is_local() {
    local ip="$1" l
    for l in $LOCAL_IPS; do [[ "$ip" == "$l" ]] && return 0; done
    return 1
}

# Reject values that can't be a real label: empty, a comma-joined list (a
# multi-value field tshark couldn't flatten to one answer), or bare digits
# (a real hostname/SNI is never just a number — seen in the wild as a stray
# port number leaking into a label field).
is_valid_label() {
    local v="$1"
    [[ -n "$v" && "$v" != *,* && ! "$v" =~ ^[0-9]+$ ]]
}

# IPFILE:    dir<tab>remote_ip<tab>local_port per packet (for counting; dir is IN/OUT)
# LBLFILE:   remote_ip<tab>rank<tab>label — every label we've seen for an IP,
#            plus how good it is (1=DNS/SNI, 2=HTTP host, 3=reverse-DNS,
#            4=RDAP org name fallback).
#            print_table keeps the best (lowest) rank per IP, not the latest.
# PORTFILE:  local_port<tab>process — snapshot of what ss says owns each local
#            port right now, refreshed every display tick (not historical: a
#            port that's since closed or been reused won't attribute correctly).
IPFILE=$(mktemp)
LBLFILE=$(mktemp)
PORTFILE=$(mktemp)
RDAP_TRIED=$(mktemp)

printf '\033[?1049h'  # enter alternate screen buffer

cleanup() { kill "$BGPID" "$RESOLVER_PID" 2>/dev/null; rm -f "$IPFILE" "$LBLFILE" "$PORTFILE" "$RDAP_TRIED"; printf '\033[?1049l'; exit; }
trap cleanup INT TERM EXIT

# === Capture: classify each packet as IN/OUT, log remote IP, cache any named label ===
# -n: fully numeric, no built-in name resolution — tshark's own PTR lookups are
# synchronous and were both a capture-performance hazard and a source of
# never-ending reverse-DNS relabeling. Reverse DNS is handled entirely by the
# background resolver below instead. QUIC's SNI needs no separate field: tshark
# decrypts the QUIC Initial and hands the embedded ClientHello to the regular
# TLS dissector, so it shows up under tls.handshake.extensions_server_name too.
tshark -i "$IFACE" -l -q -n \
    -T fields -E separator=$'\x1f' \
    -e ip.src \
    -e ip.dst \
    -e ipv6.src \
    -e ipv6.dst \
    -e http.host \
    -e tls.handshake.extensions_server_name \
    -e dns.qry.name \
    -e dns.a \
    -e dns.aaaa \
    -e tcp.srcport \
    -e tcp.dstport \
    -e udp.srcport \
    -e udp.dstport \
    2>/dev/null | \
while IFS=$'\x1f' read -r src4 dst4 src6 dst6 http_host sni qname dns_a dns_aaaa tcp_sport tcp_dport udp_sport udp_dport; do
    # DNS answers map arbitrary resolved IPs to the queried name — unrelated to
    # this packet's own src/dst, so handle it independently of dir/rip below.
    # A query message never carries answer data, so requiring a resolved
    # address here is sufficient to know this is a response (no need to also
    # check dns.flags.response — which tshark renders as True/False, not 1/0,
    # and silently never matched a plain "1" comparison).
    # A comma in qname means multiple questions got flattened into one field;
    # there's no reliable way to split it back to per-answer names, so skip it
    # rather than caching every answer under the whole garbled string.
    if is_valid_label "$qname" && [[ -n "$dns_a$dns_aaaa" ]]; then
        IFS=',' read -ra addrs <<< "${dns_a},${dns_aaaa}"
        for a in "${addrs[@]}"; do
            [[ -n "$a" ]] && printf '%s\t1\t%s\n' "$a" "$qname" >> "$LBLFILE"
        done
    fi

    # Prefer whichever address family this packet actually used.
    src="${src4:-$src6}"; dst="${dst4:-$dst6}"
    src="${src%%,*}"   # tshark can return comma-separated IPs on tunneled packets; take first
    dst="${dst%%,*}"
    [[ -z "$src" || -z "$dst" ]] && continue

    sport="${tcp_sport:-$udp_sport}"; dport="${tcp_dport:-$udp_dport}"

    if is_local "$src"; then
        dir=OUT; rip="$dst"; lport="$sport"
    elif is_local "$dst"; then
        dir=IN; rip="$src"; lport="$dport"
    else
        continue   # neither side is us (broadcast/multicast noise)
    fi

    printf '%s\t%s\t%s\n' "$dir" "$rip" "$lport" >> "$IPFILE"
    if   is_valid_label "$sni" && [[ "$sni" != "$rip" ]];             then printf '%s\t1\t%s\n' "$rip" "$sni" >> "$LBLFILE"
    elif is_valid_label "$http_host" && [[ "$http_host" != "$rip" ]]; then printf '%s\t2\t%s\n' "$rip" "$http_host" >> "$LBLFILE"
    fi
done &
BGPID=$!

# === Background resolver: reverse-DNS any remote IP not yet in label cache,
#     with RDAP org-name fallback for IPs that have no PTR record ===
# RDAP_TRIED: tracks IPs we've already attempted RDAP for, to avoid
#             repeated expensive lookups for the same IP.

(
    while true; do
        sleep 2
        [[ -s "$IPFILE" ]] || continue

        # remote IPs seen but not yet labelled at all
        comm -23 \
            <(awk -F'\t' '{print $2}' "$IPFILE" 2>/dev/null | sort -u) \
            <(awk -F'\t' '{print $1}' "$LBLFILE" 2>/dev/null | sort -u) \
        | while read -r ip; do
            name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2; exit}')
            if is_valid_label "$name" && [[ "$name" != "$ip" ]]; then
                printf '%s\t3\t%s\n' "$ip" "$name" >> "$LBLFILE"
            elif ! grep -qxF "$ip" "$RDAP_TRIED" 2>/dev/null; then
                # No PTR record — try RDAP for an org/entity name
                echo "$ip" >> "$RDAP_TRIED"
                rdap_url="https://rdap.arin.net/registry/ip/${ip}"
                org=$(curl -sfL --max-time 5 "$rdap_url" 2>/dev/null \
                    | grep -o '"name" *: *"[^"]*"' \
                    | head -5 \
                    | awk -F'"' '
                        # skip pure numbers and internal ARIN handle patterns
                        $4 !~ /^[0-9-]+$/ && $4 !~ /^[A-Z]+-[0-9]+-ARIN$/ && length($4) > 1 { print $4; exit }
                    ')
                if is_valid_label "$org" && [[ "$org" != "$ip" ]]; then
                    printf '%s\t4\t[%s]\n' "$ip" "$org" >> "$LBLFILE"
                fi
            fi
        done
    done
) &
RESOLVER_PID=$!

divider=$(printf '─%.0s' {1..72})

print_table() {
    local dir="$1" title="$2"
    printf '\033[1m%s\033[0m\n' "$title"
    printf '\033[1m%-7s  %-22s  %-10s  %s\033[0m\n' "PACKETS" "$([[ "$dir" == OUT ]] && echo "DESTINATION IP" || echo "SENDER IP")" "PROCESS" "HOST / URL / COMPANY"
    echo "$divider"

    awk -F'\t' -v lbl="$LBLFILE" -v portlbl="$PORTFILE" -v want="$dir" '
        BEGIN {
            while ((getline line < lbl) > 0) {
                split(line, a, "\t")   # ip, rank, label — keep the best (lowest) rank seen
                if (!(a[1] in rank) || a[2]+0 < rank[a[1]]) {
                    rank[a[1]] = a[2]+0; cache[a[1]] = a[3]
                }
            }
            while ((getline line < portlbl) > 0) {
                split(line, port, "\t"); portproc[port[1]] = port[2]   # local port -> process, current snapshot
            }
        }
        $1 == want {
            count[$2]++
            if ($3 in portproc) procs[$2][portproc[$3]] = 1
        }
        END {
            for (ip in count) {
                label = (ip in cache) ? cache[ip] : ip
                plist = ""
                for (procname in procs[ip]) plist = (plist == "" ? procname : plist "," procname)
                print count[ip] "\t" ip "\t" (plist == "" ? "-" : plist) "\t" label
            }
        }
    ' "$IPFILE" \
        | sort -rn \
        | head -15 \
        | while IFS=$'\t' read -r count ip proc label; do
            printf '%-7s  %-22s  %-10s  %s\n' "$count" "$ip" "$proc" "$label"
          done
}

# === Display loop ===
while kill -0 "$BGPID" 2>/dev/null; do
    sleep "$REFRESH"
    clear
    printf '\033[1m netwatch  ·  %s  ·  %s \033[0m\n\n' "$IFACE" "$(date +%H:%M:%S)"

    # Snapshot which local process owns which local port right now (own sockets
    # only, no root needed). This only reflects currently-open connections, so
    # traffic from a socket that's already closed by the time we render won't
    # get a process name — still enough to catch anything live and unexpected.
    ss -H -tupn 2>/dev/null | awk '
        NF >= 7 {
            laddr = $5; sub(/.*:/, "", laddr)
            if (match($7, /\("([^"]+)"/, m)) print laddr "\t" m[1]
        }
    ' > "$PORTFILE"

    print_table OUT "OUTGOING (you → remote)"
    echo ""
    print_table IN "INCOMING (remote → you)"

    if [[ -s "$IPFILE" ]]; then
        echo ""
        total=$(wc -l < "$IPFILE")
        out_total=$(awk -F'\t' '$1=="OUT"' "$IPFILE" | wc -l)
        in_total=$(awk -F'\t' '$1=="IN"' "$IPFILE" | wc -l)
        uniq_ips=$(awk -F'\t' '{print $2}' "$IPFILE" | sort -u | wc -l)
        resolved=$(awk -F'\t' '{print $1}' "$LBLFILE" 2>/dev/null | sort -u | wc -l)
        printf 'Total packets: %-6s  Out: %-6s  In: %-6s  Unique IPs: %-4s  Resolved: %s\n' \
            "$total" "$out_total" "$in_total" "$uniq_ips" "$resolved"
    else
        echo "  (waiting for traffic...)"
    fi
done
